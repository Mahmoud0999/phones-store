# Sharkawy Phones Store - Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/sharkawy-phones

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Payment Processing
STRIPE_API_KEY=sk_test_your_stripe_key_here
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key_here

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_SECURE=false
ORDER_EMAIL=mahmoudkabel@gmail.com

# Shipping Configuration
SHIPPING_STANDARD_COST=5
SHIPPING_EXPRESS_COST=15
SHIPPING_OVERNIGHT_COST=30

# Tax Rate
TAX_RATE=0.10

# Admin Configuration
ADMIN_EMAIL=admin@sharkawy.com
ADMIN_PASSWORD=change-this-password
